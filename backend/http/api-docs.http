# Needs the dev profile, which ./mvnw spring-boot:run activates. Without it both answer 404.

### OpenAPI document (springdoc). Lists every endpoint; none yet besides the API info.
GET {{baseUrl}}/v3/api-docs
Accept: application/json

> {%
    client.test("OpenAPI document is served", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.info.title === "ask-my-docs API", "title " + response.body.info.title);
    });
%}

### Swagger UI: redirects to /swagger-ui/index.html. Open it in a browser to see the UI.
GET {{baseUrl}}/swagger-ui.html

> {%
    client.test("Swagger UI page is served", () => {
        client.assert(response.status === 200, "status " + response.status);
    });
%}
