# Local secrets for ask-my-docs.
# Copy this file to .env and fill in real values. .env is gitignored: never commit it.
# Keep only placeholders here; this file is committed and scanned by gitleaks.

# Postgres + pgvector, started by compose.yaml (docker compose up -d --wait).
# Credentials are set when the data volume is first created; changing them later
# needs `docker compose down -v` (which deletes the data).
# Choose a password: compose refuses to start while it is empty.
POSTGRES_DB=askmydocs
POSTGRES_USER=askmydocs
POSTGRES_PASSWORD=
# Host port, bound to 127.0.0.1 only. Uncomment if 5432 is taken.
# POSTGRES_PORT=5432

# Grafana service account token (observability)
GRAFANA_TOKEN=change-me
